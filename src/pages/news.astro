---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const news = [
  { date: '3 November 2026', title: 'Presented at IAU Symposium 409 in Tokyo', text: 'Presented how Photon SCNSM, NOC Sudan, and Zool Astro help sustain astronomy and physics education and research during the conflict in Sudan.', image: '/images/home/IAU_Abu.jpg', href: '/talks', label: 'View the conference talk' },
  { date: '12 August 2026', title: 'Inclusive Solar Eclipse Observation in Reus', text: 'Joined the ICE-CSIC organising team for an accessible total solar eclipse observation using sonification and light-sound devices for people with visual disabilities.', image: '/images/outreach/solar-eclipse.jpg', href: '/outreach', label: 'Read about the outreach work' },
  { date: 'July to August 2026', title: 'Expanding Horizons in Physics in Sudan II', text: 'Through Photon SCNSM and ICTP Physics Without Frontiers, helped deliver an intensive online workshop on Density Functional Theory for Sudanese students and early-career researchers.', image: '/images/gallery/PWFll_Sudan_Final_Poster.jpeg', href: 'https://indico.ictp.it/event/11353/', label: 'Initiative webpage', external: true },
  { date: 'July 2026', title: 'Joined the International Astronomical Union', text: 'Became a member of the IAU, joining a global community advancing astronomy through research, education, outreach, and international collaboration.', image: '/images/home/IAUـMember.png' },
  { date: 'June 2026', title: 'NewAthena Rising: Compact Objects Meeting', text: 'Attended the Science Working Group 4 meeting at ICE-CSIC in Barcelona, learning about the next X-ray observatory and connecting with the early-career community.', image: '/images/gallery/rising_newathena.jpeg' },
  { date: 'June 2025', title: 'ICTP Physics Without Frontiers, Sudan', text: 'Co-led a six-week international initiative empowering Sudanese students and researchers through advanced online seminars in physics and astronomy.', image: '/images/gallery/PWF_SUDAN_FinalPoster.jpg', href: 'https://indico.ictp.it/event/11030/overview', label: 'Initiative webpage', external: true },
  { date: 'October 2024', title: 'PhD Defense Completed', text: 'Successfully defended a thesis on magnetars and X-ray astronomy at ICE-CSIC and UAB.', image: '/images/gallery/Phd_thesis_cover.jpg', href: 'https://tesisenred.net/bitstream/handle/10803/693188/aai1de1.pdf?sequence=1&isAllowed=y', label: 'Read thesis online', external: true },
  { date: '9 April 2024', title: 'New Magnetar Paper Published', text: 'Research on SGR J1935+2154 was published in The Astrophysical Journal.', href: '/publications', label: 'See publications' }
];
---

<Layout title="News & Activities | Abubakr Ibrahim" description="News and activities from Abubakr Ibrahim's research, outreach, and scientific collaboration.">
  <div class="flex min-h-screen flex-col"><Navigation /><main class="flex-grow px-4 pb-16 pt-28 sm:px-6 lg:px-8"><div class="mx-auto max-w-4xl"><p class="text-sm font-semibold uppercase tracking-[0.18em] text-space-orange-light">Research · outreach · collaboration</p><h1 class="mt-2 text-4xl font-bold text-white">News & Activities</h1><p class="mt-4 max-w-2xl leading-7 text-slate-200">Updates from research, scientific engagement, and public astronomy activities.</p><div class="mt-10 space-y-5">{news.map((item) => <article class="flex flex-col gap-5 rounded-2xl border border-space-blue-light/15 bg-space-blue-dark/45 p-5 sm:flex-row">{item.image && <img src={item.image} alt="" class="h-28 w-full shrink-0 rounded-xl object-cover sm:w-36" loading="lazy" />}<div><p class="text-sm font-semibold text-space-orange-light">{item.date}</p><h2 class="mt-1 text-xl font-semibold text-white">{item.title}</h2><p class="mt-2 leading-6 text-slate-200">{item.text}</p>{item.href && <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined} class="mt-3 inline-flex font-semibold text-space-blue-light hover:text-space-orange-light hover:underline">{item.label} <span aria-hidden="true">→</span></a>}</div></article>)}</div></div></main><Footer /></div>
</Layout>
