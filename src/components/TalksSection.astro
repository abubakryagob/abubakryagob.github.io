<section id="talks" class="py-20 bg-gradient-to-b from-space-blue-dark/30 to-transparent">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
      Talks, Conferences & Workshops
    </h2>
    <div class="grid md:grid-cols-2 gap-8">
      {talks.map(talk => (
        <div class="bg-space-blue-dark/40 backdrop-blur-sm rounded-xl p-6 border border-space-blue-light/10 hover:border-space-blue-light/30 transition-all duration-300">
          <div class="mb-4">
            <h3 class="text-xl font-semibold text-white mb-1">{talk.title}</h3>
            <div class="text-space-orange text-sm font-semibold mb-1">{talk.date}</div>
            {talk.event && <div class="text-space-blue-light text-sm mb-2">{talk.event}</div>}
            {"slidesPdf" in talk && talk.slidesPdf && (
              <a
                href={talk.slidesPdf}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 mt-2 text-space-orange-light hover:text-space-blue-light text-sm font-semibold transition-colors"
              >
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Slides (PDF)
              </a>
            )}
          </div>
          {talk.images && talk.images.length > 0 && (
            <div class="flex flex-wrap gap-4 mb-4">
              {talk.images.map(img => (
                <img src={img} alt={talk.title} class="w-full sm:w-64 h-48 object-cover rounded-lg border border-space-blue-light/20 shadow" loading="lazy" />
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
