---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [latest, ...recent] = posts;
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<section id="blog" class="py-20 bg-gradient-to-b from-space-blue-dark/30 to-transparent">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">Blog & Updates</h2>
    {latest ? (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="group col-span-full lg:col-span-2">
          <article class="bg-space-blue-dark/40 backdrop-blur-sm rounded-xl p-6 border border-space-blue-light/10 hover:border-space-blue-light/30 transition-all duration-300 h-full">
            <div class="flex items-center mb-4"><span class="bg-space-orange/20 text-space-orange-light px-3 py-1 rounded-full text-sm">Latest Update</span><time datetime={latest.data.pubDate.toISOString()} class="text-gray-400 text-sm ml-auto">{formatDate(latest.data.pubDate)}</time></div>
            <h3 class="text-2xl font-semibold text-white mb-3 group-hover:text-space-orange-light transition-colors">{latest.data.title}</h3>
            <p class="text-gray-300 mb-4">{latest.data.description}</p>
            <a href={`/blog/${latest.id}`} class="inline-flex items-center text-space-blue-light hover:text-space-orange-light transition-colors">Read more <span aria-hidden="true" class="ml-1 group-hover:translate-x-1 transition-transform">→</span></a>
          </article>
        </div>
        <div class="space-y-6 lg:col-span-1">
          {recent.map((post) => <article class="bg-space-blue-dark/40 backdrop-blur-sm rounded-xl p-6 border border-space-blue-light/10 hover:border-space-blue-light/30 transition-all duration-300"><time datetime={post.data.pubDate.toISOString()} class="text-gray-400 text-sm">{formatDate(post.data.pubDate)}</time><h3 class="text-lg font-semibold text-white mt-2 mb-2 hover:text-space-orange-light transition-colors">{post.data.title}</h3><p class="text-gray-300 line-clamp-2">{post.data.description}</p><a href={`/blog/${post.id}`} class="inline-block mt-3 text-sm text-space-blue-light hover:text-space-orange-light">Read more →</a></article>)}
        </div>
      </div>
    ) : <p class="text-center text-gray-300">No posts yet.</p>}
  </div>
</section>
